{
  "name": "auraflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --host 127.0.0.1 --mode e2e",
    "demo:seed": "node scripts/seed-demo.mjs",
    "build": "node scripts/check-config.mjs && tsc -b && tsc -p tsconfig.business.json && vite build",
    "dev:business": "node --import tsx scripts/business-dev.ts",
    "test:business": "node --import tsx --test tests/business.test.ts",
    "test:business:integration": "node --import tsx --test tests/business-integration.test.ts",
    "check:config": "node scripts/check-config.mjs",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/domain.test.ts tests/config.test.ts tests/workflow.test.ts",
    "test:security": "node --import tsx --test tests/security.test.ts",
    "test:e2e": "playwright test",
    "test:production": "node tests/production-smoke.mjs",
    "preview": "vite preview",
    "grant-admin": "node scripts/grant-admin.mjs"
  },
  "overrides": {
    "teeny-request": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
