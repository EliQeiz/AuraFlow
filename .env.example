VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_UNSPLASH_ACCESS_KEY=

# Supabase cutover configuration. The publishable key is safe for browser use;
# the service-role key below must remain server-side.
VITE_SUPABASE_URL=https://tbugdnfqajhevednmvim.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for older Supabase projects. Prefer the publishable key.
VITE_SUPABASE_ANON_KEY=
# Keep Firebase active until the complete Supabase migration release is tested.
VITE_BACKEND_PROVIDER=firebase

# Optional app-only shell; public pages remain available through explicit routes.
VITE_APP_ONLY=false
# Local development only. Never point emulator tests at a live project.
VITE_USE_EMULATORS=false

# Business runtime: server only. Never prefix these with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=https://tbugdnfqajhevednmvim.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Server routes stay on Firebase until their Supabase command handlers are deployed.
AURAFLOW_BACKEND_PROVIDER=firebase
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TENANTS_JSON=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Business Center provisioning: base domain used only after AuraFlow verifies
# DNS and hosting externally. Keep blank until tenant subdomains are ready.
AURAFLOW_TENANT_BASE_DOMAIN=
