rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function stringBetween(data, field, minimum, maximum) {
      return data[field] is string
        && data[field].size() >= minimum
        && data[field].size() <= maximum;
    }

    function optionalString(data, field, maximum) {
      return !data.keys().hasAny([field])
        || (data[field] is string && data[field].size() <= maximum);
    }

    function optionalStringList(data, field, maximum) {
      return !data.keys().hasAny([field])
        || (data[field] is list && data[field].size() <= maximum);
    }

    function optionalBool(data, field) {
      return !data.keys().hasAny([field])
        || data[field] is bool;
    }

    function validPlatformMode(data, field) {
      return !data.keys().hasAny([field])
        || data[field] in ['managed-hosted', 'custom-build', 'prototype-only'];
    }

    function validPrototypeSpec() {
      return !request.resource.data.keys().hasAny(['prototypeSpec'])
        || (
          request.resource.data.prototypeSpec is map
          && request.resource.data.prototypeSpec.keys().hasOnly([
            'solutionSlug',
            'suiteSlug',
            'businessName',
            'platformMode',
            'subdomainPreference',
            'selectedModules',
            'selectedWorkflows',
            'selectedRoles',
            'brandTone',
            'colorPreference',
            'adminRoles',
            'coreWorkflows',
            'contentNotes',
            'dataSources',
            'complianceNotes',
            'launchModel',
            'selectedBuilderFeatures',
            'themePreset',
            'primaryColor',
            'accentColor',
            'logoDirection',
            'bannerDirection',
            'mediaPlan',
            'automationNeeds',
            'paymentPlan',
            'tenantAdminNotes',
            'contentOwnershipConfirmed'
          ])
          && optionalString(request.resource.data.prototypeSpec, 'solutionSlug', 180)
          && optionalString(request.resource.data.prototypeSpec, 'suiteSlug', 180)
          && stringBetween(request.resource.data.prototypeSpec, 'businessName', 1, 160)
          && validPlatformMode(request.resource.data.prototypeSpec, 'platformMode')
          && optionalString(request.resource.data.prototypeSpec, 'subdomainPreference', 120)
          && optionalStringList(request.resource.data.prototypeSpec, 'selectedModules', 30)
          && optionalStringList(request.resource.data.prototypeSpec, 'selectedWorkflows', 20)
          && optionalStringList(request.resource.data.prototypeSpec, 'selectedRoles', 20)
          && optionalString(request.resource.data.prototypeSpec, 'brandTone', 120)
          && optionalString(request.resource.data.prototypeSpec, 'colorPreference', 120)
          && optionalStringList(request.resource.data.prototypeSpec, 'adminRoles', 20)
          && stringBetween(request.resource.data.prototypeSpec, 'coreWorkflows', 30, 6000)
          && stringBetween(request.resource.data.prototypeSpec, 'contentNotes', 20, 6000)
          && optionalString(request.resource.data.prototypeSpec, 'dataSources', 6000)
          && optionalString(request.resource.data.prototypeSpec, 'complianceNotes', 4000)
          && optionalString(request.resource.data.prototypeSpec, 'launchModel', 120)
          && optionalStringList(request.resource.data.prototypeSpec, 'selectedBuilderFeatures', 20)
          && optionalString(request.resource.data.prototypeSpec, 'themePreset', 120)
          && optionalString(request.resource.data.prototypeSpec, 'primaryColor', 32)
          && optionalString(request.resource.data.prototypeSpec, 'accentColor', 32)
          && optionalString(request.resource.data.prototypeSpec, 'logoDirection', 4000)
          && optionalString(request.resource.data.prototypeSpec, 'bannerDirection', 4000)
          && optionalString(request.resource.data.prototypeSpec, 'mediaPlan', 5000)
          && optionalStringList(request.resource.data.prototypeSpec, 'automationNeeds', 12)
          && optionalString(request.resource.data.prototypeSpec, 'paymentPlan', 4000)
          && optionalString(request.resource.data.prototypeSpec, 'tenantAdminNotes', 5000)
          && optionalBool(request.resource.data.prototypeSpec, 'contentOwnershipConfirmed')
          && (!request.resource.data.prototypeSpec.keys().hasAny(['contentOwnershipConfirmed'])
            || request.resource.data.prototypeSpec.contentOwnershipConfirmed == true)
        );
    }

    function validContact() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'service',
          'budget',
          'message',
          'createdAt'
        ])
        && stringBetween(request.resource.data, 'name', 2, 120)
        && stringBetween(request.resource.data, 'email', 3, 254)
        && optionalString(request.resource.data, 'phone', 40)
        && stringBetween(request.resource.data, 'service', 1, 160)
        && stringBetween(request.resource.data, 'budget', 1, 40)
        && stringBetween(request.resource.data, 'message', 20, 4000)
        && request.resource.data.createdAt == request.time;
    }

    function validQuote() {
      return request.resource.data.keys().hasOnly([
          'projectType',
          'details',
          'audience',
          'features',
          'budget',
          'urgency',
          'name',
          'email',
          'phone',
          'contactMethod',
          'templateSlug',
          'createdAt'
        ])
        && stringBetween(request.resource.data, 'projectType', 1, 160)
        && stringBetween(request.resource.data, 'details', 20, 6000)
        && stringBetween(request.resource.data, 'audience', 1, 500)
        && request.resource.data.features is list
        && request.resource.data.features.size() <= 16
        && request.resource.data.budget is int
        && request.resource.data.budget >= 500
        && request.resource.data.budget <= 50000
        && stringBetween(request.resource.data, 'urgency', 1, 80)
        && stringBetween(request.resource.data, 'name', 1, 120)
        && stringBetween(request.resource.data, 'email', 3, 254)
        && stringBetween(request.resource.data, 'phone', 0, 40)
        && stringBetween(request.resource.data, 'contactMethod', 1, 40)
        && optionalString(request.resource.data, 'templateSlug', 180)
        && request.resource.data.createdAt == request.time;
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'avatarUrl',
          'plan',
          'savedTemplates',
          'projectCount',
          'notifications',
          'theme'
        ])
        && request.resource.data.uid == uid
        && stringBetween(request.resource.data, 'name', 1, 120)
        && stringBetween(request.resource.data, 'email', 0, 254)
        && optionalString(request.resource.data, 'phone', 40)
        && optionalString(request.resource.data, 'avatarUrl', 2048)
        && stringBetween(request.resource.data, 'plan', 1, 80)
        && request.resource.data.savedTemplates is list
        && request.resource.data.savedTemplates.size() <= 100
        && request.resource.data.projectCount is int
        && request.resource.data.projectCount >= 0
        && request.resource.data.projectCount <= 10000
        && (!request.resource.data.keys().hasAny(['notifications']) || request.resource.data.notifications is bool)
        && (!request.resource.data.keys().hasAny(['theme']) || request.resource.data.theme in ['dark', 'light', 'system']);
    }

    function validStatus(value) {
      return value in ['Submitted', 'Discovery', 'Designing', 'Building', 'Review', 'Completed', 'On Hold'];
    }

    function draftPath(path, uid) {
      let parts = path.split('/');
      return path is string && path.size() <= 600
        && (path == '' || (parts.size() == 4
          && parts[0] == 'drafts' && parts[1] == uid));
    }

    function validDraftMedia(paths, uid) {
      let n = paths.size();
      let joined = paths.join('|');
      return paths is list && n <= 20 && joined.size() <= 12000
        && (n == 0 || joined.matches('^drafts/[^/|]+/[^/|]+/[^/|]+(\\|drafts/[^/|]+/[^/|]+/[^/|]+)*$'))
        && (n < 1 || paths[0].split('/')[1] == uid) && (n < 2 || paths[1].split('/')[1] == uid)
        && (n < 3 || paths[2].split('/')[1] == uid) && (n < 4 || paths[3].split('/')[1] == uid)
        && (n < 5 || paths[4].split('/')[1] == uid) && (n < 6 || paths[5].split('/')[1] == uid)
        && (n < 7 || paths[6].split('/')[1] == uid) && (n < 8 || paths[7].split('/')[1] == uid)
        && (n < 9 || paths[8].split('/')[1] == uid) && (n < 10 || paths[9].split('/')[1] == uid)
        && (n < 11 || paths[10].split('/')[1] == uid) && (n < 12 || paths[11].split('/')[1] == uid)
        && (n < 13 || paths[12].split('/')[1] == uid) && (n < 14 || paths[13].split('/')[1] == uid)
        && (n < 15 || paths[14].split('/')[1] == uid) && (n < 16 || paths[15].split('/')[1] == uid)
        && (n < 17 || paths[16].split('/')[1] == uid) && (n < 18 || paths[17].split('/')[1] == uid)
        && (n < 19 || paths[18].split('/')[1] == uid) && (n < 20 || paths[19].split('/')[1] == uid);
    }

    function validDesign(data, uid) {
      return data is map
        && data.schemaVersion == 1
        && stringBetween(data, 'suiteSlug', 1, 180)
        && stringBetween(data, 'name', 2, 120)
        && stringBetween(data, 'headline', 0, 160)
        && stringBetween(data, 'description', 0, 6000)
        && data.primaryColor.matches('^#[a-fA-F0-9]{6}$')
        && data.accentColor.matches('^#[a-fA-F0-9]{6}$')
        && data.theme in ['light', 'dark']
        && data.font in ['modern', 'classic']
        && data.modules is list && data.modules.size() >= 1 && data.modules.size() <= 30
        && data.roles is list && data.roles.size() <= 20
        && data.workflows is list && data.workflows.size() <= 20
        && data.pages is list && data.pages.size() >= 1 && data.pages.size() <= 15
        && stringBetween(data, 'notes', 0, 6000)
        && stringBetween(data, 'logoPath', 0, 600)
        && stringBetween(data, 'bannerPath', 0, 600)
        && draftPath(data.logoPath, uid) && draftPath(data.bannerPath, uid)
        && validDraftMedia(data.mediaPaths, uid);
    }

    function validDraft(uid) {
      return validDesign(request.resource.data, uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'suiteSlug', 'name', 'headline', 'description', 'primaryColor', 'accentColor', 'theme', 'font', 'modules', 'roles', 'workflows', 'pages', 'notes', 'logoPath', 'bannerPath', 'mediaPaths', 'userId', 'revision', 'updatedAt'])
        && request.resource.data.userId == uid
        && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time;
    }

    function savedDesignMatches() {
      let saved = get(/databases/$(database)/documents/users/$(request.auth.uid)/drafts/$(request.resource.data.designDraftId)).data;
      return request.resource.data.design is map && saved.userId == request.auth.uid
        && request.resource.data.design.diff(saved).affectedKeys().hasOnly(['userId', 'revision', 'updatedAt'])
        && !request.resource.data.design.keys().hasAny(['userId', 'revision', 'updatedAt']);
    }

    function validProjectCreate() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'clientName',
          'clientEmail',
          'title',
          'projectType',
          'description',
          'audience',
          'budget',
          'timeline',
          'referenceLinks',
          'templateSlug',
          'solutionSlug',
          'platformMode',
          'subdomainPreference',
          'prototypeSpec',
          'design',
          'designDraftId',
          'assets',
          'previews',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && stringBetween(request.resource.data, 'clientName', 1, 120)
        && stringBetween(request.resource.data, 'clientEmail', 3, 254)
        && stringBetween(request.resource.data, 'title', 2, 180)
        && stringBetween(request.resource.data, 'projectType', 1, 180)
        && stringBetween(request.resource.data, 'description', 40, 12000)
        && stringBetween(request.resource.data, 'audience', 1, 800)
        && request.resource.data.budget is int
        && request.resource.data.budget >= 39
        && request.resource.data.budget <= 100000
        && stringBetween(request.resource.data, 'timeline', 1, 120)
        && request.resource.data.referenceLinks is list
        && request.resource.data.referenceLinks.size() <= 8
        && optionalString(request.resource.data, 'templateSlug', 180)
        && optionalString(request.resource.data, 'solutionSlug', 180)
        && validPlatformMode(request.resource.data, 'platformMode')
        && optionalString(request.resource.data, 'subdomainPreference', 120)
        && validPrototypeSpec()
        && optionalString(request.resource.data, 'designDraftId', 180)
        && (!request.resource.data.keys().hasAny(['design']) || savedDesignMatches())
        && request.resource.data.assets is list
        && request.resource.data.assets.size() == 0
        && request.resource.data.previews is list
        && request.resource.data.previews.size() == 0
        && request.resource.data.status == 'Submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAsset(asset, uid, projectId, kind) {
      let parts = asset.path.split('/');
      return asset is map
        && asset.keys().hasOnly(['id', 'name', 'path', 'url', 'contentType', 'kind', 'uploadedBy'])
        && stringBetween(asset, 'id', 1, 200)
        && stringBetween(asset, 'name', 1, 255)
        && stringBetween(asset, 'path', 1, 600)
        && asset.url == ''
        && optionalString(asset, 'contentType', 160)
        && asset.kind == kind && asset.uploadedBy == request.auth.uid
        && ((parts.size() == 5 && parts[0] == 'projects' && parts[1] == uid
          && parts[2] == projectId && parts[3] == (kind == 'preview' ? 'previews' : 'references'))
          || (kind == 'reference' && draftPath(asset.path, uid)));
    }

    function appendAsset(previous, next, uid, projectId, kind) {
      return next == previous || (next.size() == previous.size() + 1
        && (previous.size() == 0 || next[0:previous.size()] == previous)
        && validAsset(next[previous.size()], uid, projectId, kind));
    }

    function clientProjectUpdate(projectId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assets',
          'lastClientNote',
          'status',
          'updatedAt'
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.assets is list
        && request.resource.data.assets.size() <= 32
        && appendAsset(resource.data.assets, request.resource.data.assets, resource.data.userId, projectId, 'reference')
        && request.resource.data.previews == resource.data.previews
        && optionalString(request.resource.data, 'lastClientNote', 4000)
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'Review')
        && request.resource.data.updatedAt == request.time;
    }

    function adminProjectUpdate(projectId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminSummary',
          'deadline',
          'previews',
          'productionUrl',
          'stagingUrl',
          'status',
          'tenantSlug',
          'lastEventId',
          'updatedAt'
        ])
        && request.resource.data.previews is list
        && request.resource.data.previews.size() <= 32
        && appendAsset(resource.data.previews, request.resource.data.previews, resource.data.userId, projectId, 'preview')
        && optionalString(request.resource.data, 'adminSummary', 6000)
        && optionalString(request.resource.data, 'deadline', 120)
        && optionalString(request.resource.data, 'productionUrl', 2048)
        && optionalString(request.resource.data, 'stagingUrl', 2048)
        && optionalString(request.resource.data, 'tenantSlug', 120)
        && optionalString(request.resource.data, 'lastEventId', 128)
        && validStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time;
    }

    function projectOwner(projectId) {
      return signedIn()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    function validMessage(role) {
      return request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'role',
          'text',
          'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && stringBetween(request.resource.data, 'authorName', 1, 120)
        && stringBetween(request.resource.data, 'text', 2, 4000)
        && request.resource.data.role == role
        && request.resource.data.createdAt == request.time;
    }

    match /contacts/{contactId} {
      allow create: if signedIn() && validContact();
      allow read, update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow create: if signedIn() && validQuote();
      allow read, update, delete: if false;
    }

    match /newsletter/{subscriberId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && stringBetween(request.resource.data, 'email', 3, 254)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProfile(uid)
        && request.resource.data.plan == 'Starter'
        && request.resource.data.projectCount == 0;
      allow update: if owns(uid)
        && validProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'phone',
          'avatarUrl',
          'notifications',
          'savedTemplates',
          'theme'
        ]);
      allow delete: if owns(uid);

      match /drafts/{draftId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validDraft(uid) && request.resource.data.revision == 1;
        allow update: if owns(uid) && validDraft(uid)
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if owns(uid);
        match /versions/{versionId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && request.resource.data == getAfter(/databases/$(database)/documents/users/$(uid)/drafts/$(draftId)).data
            && request.resource.data.updatedAt == request.time
            && versionId == string(request.resource.data.revision);
          allow update, delete: if false;
        }
      }
      match /eventReads/{eventId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if owns(uid);
      }
      match /snippets/{snippetId} {
        allow read, delete: if owns(uid) && isAdmin();
        allow create, update: if owns(uid) && isAdmin()
          && request.resource.data.keys().hasOnly(['title', 'text'])
          && stringBetween(request.resource.data, 'title', 2, 80)
          && stringBetween(request.resource.data, 'text', 2, 4000);
      }
    }

    function validWork() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'title', 'details', 'dueDate', 'assignedTo', 'url', 'state', 'response', 'authorId', 'updatedBy', 'lastEventId', 'createdAt', 'updatedAt'])
        && d.kind in ['milestone', 'review', 'change']
        && stringBetween(d, 'title', 3, 160) && stringBetween(d, 'details', 0, 4000)
        && d.dueDate.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.assignedTo in ['client', 'team']
        && stringBetween(d, 'url', 0, 2048) && (d.url == '' || d.url.matches('^https://[^ /]+.*$'))
        && stringBetween(d, 'response', 0, 4000)
        && stringBetween(d, 'lastEventId', 1, 128)
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function workTransition() {
      let old = resource.data;
      let next = request.resource.data;
      return next.diff(old).affectedKeys().hasOnly(['state', 'response', 'updatedBy', 'updatedAt', 'lastEventId'])
        && next.lastEventId != old.lastEventId
        && (!(next.state in ['changes-requested', 'declined']) || next.response.size() >= 3)
        && ((old.kind == 'milestone' && (isAdmin() || old.assignedTo == 'client')
            && ((old.state == 'open' && next.state == 'done') || (old.state == 'done' && next.state == 'open')))
          || (old.kind == 'review' && !isAdmin() && old.state == 'open' && next.state in ['approved', 'changes-requested'])
          || (old.kind == 'change' && isAdmin()
            && ((old.state == 'open' && next.state in ['accepted', 'declined']) || (old.state == 'accepted' && next.state == 'done'))));
    }
    function linkedWorkEvent(projectId, itemId) {
      let d = request.resource.data;
      let event = getAfter(/databases/$(database)/documents/projectEvents/$(d.lastEventId)).data;
      return event.projectId == projectId && event.entityId == itemId
        && event.actorId == request.auth.uid && event.createdAt == request.time;
    }
    match /projectOps/{projectId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && request.resource.data.keys().hasOnly(['priority', 'updatedBy', 'updatedAt'])
        && request.resource.data.priority in ['normal', 'high', 'urgent']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /projectEvents/{eventId} {
      function validEvent() {
        let d = request.resource.data;
        let p = getAfter(/databases/$(database)/documents/projects/$(d.projectId)).data;
        let item = d.kind == 'status' ? p : getAfter(/databases/$(database)/documents/projects/$(d.projectId)/workItems/$(d.entityId)).data;
        return d.keys().hasOnly(['projectId', 'userId', 'actorId', 'entityId', 'kind', 'title', 'state', 'createdAt'])
          && d.userId == p.userId && (owns(p.userId) || isAdmin())
          && d.actorId == request.auth.uid && d.createdAt == request.time
          && item.lastEventId == eventId && item.updatedAt == request.time
          && d.title == item.title
          && ((d.kind == 'status' && isAdmin() && d.entityId == d.projectId && d.state == p.status)
            || (d.kind == item.kind && d.state == item.state && item.updatedBy == request.auth.uid));
      }
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if signedIn() && validEvent();
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow get: if (signedIn() && (!exists(/databases/$(database)/documents/projects/$(projectId)) || resource.data.userId == request.auth.uid)) || isAdmin();
      allow list: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if signedIn() && validProjectCreate();
      allow update: if (signedIn() && resource.data.userId == request.auth.uid && clientProjectUpdate(projectId))
        || (isAdmin() && adminProjectUpdate(projectId));
      allow delete: if false;

      match /workItems/{itemId} {
        allow read: if projectOwner(projectId) || isAdmin();
        allow create: if (projectOwner(projectId) || isAdmin()) && validWork()
          && request.resource.data.state == 'open' && request.resource.data.response == ''
          && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time
          && ((isAdmin() && request.resource.data.kind in ['milestone', 'review']) || (projectOwner(projectId) && request.resource.data.kind == 'change'))
          && linkedWorkEvent(projectId, itemId);
        allow update: if (projectOwner(projectId) || isAdmin()) && validWork() && workTransition() && linkedWorkEvent(projectId, itemId);
        allow delete: if false;
      }
      match /internalNotes/{noteId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'authorId', 'createdAt'])
          && stringBetween(request.resource.data, 'text', 3, 4000)
          && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if projectOwner(projectId) || isAdmin();
        allow create: if (projectOwner(projectId) && validMessage('client'))
          || (isAdmin() && validMessage('admin'));
        allow update, delete: if false;
      }
    }

    match /conversations/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['userId', 'name', 'updatedAt'])
        && request.resource.data.userId == uid
        && stringBetween(request.resource.data, 'name', 1, 120)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if owns(uid) || isAdmin();
        allow create: if (owns(uid) && validMessage('client')) || (isAdmin() && validMessage('admin'));
        allow update, delete: if false;
      }
    }

    match /blog/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
