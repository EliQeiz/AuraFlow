rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validAvatar() {
      return request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{uid}/{fileName} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validAvatar();
      allow delete: if owns(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
