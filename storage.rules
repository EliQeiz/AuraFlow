rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function validAvatar() {
      return request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)');
    }

    function validRequestAsset() {
      return request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)')
          || request.resource.contentType.matches('video/(mp4|webm)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/json'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/x-zip-compressed'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType == 'text/csv'
          || request.resource.contentType == 'text/plain');
    }

    function projectBelongsTo(uid, projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.userId == uid;
    }

    match /drafts/{uid}/{draftId}/{fileName} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid) && validRequestAsset();
      allow delete: if owns(uid);
    }

    match /avatars/{uid}/{fileName} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validAvatar();
      allow delete: if owns(uid);
    }

    match /projects/{uid}/{projectId}/references/{fileName} {
      allow read: if (owns(uid) || isAdmin()) && projectBelongsTo(uid, projectId);
      allow create, update: if owns(uid) && projectBelongsTo(uid, projectId) && validRequestAsset();
      allow delete: if owns(uid);
    }

    match /projects/{uid}/{projectId}/previews/{fileName} {
      allow read: if (owns(uid) || isAdmin()) && projectBelongsTo(uid, projectId);
      allow create, update: if isAdmin() && projectBelongsTo(uid, projectId) && validRequestAsset();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
